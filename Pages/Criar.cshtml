
@page
@model tccDiarioDeMonstros.Pages.CriarModel

@{
    ViewData["Title"] = "Cadastrar Monstro";
}

<h1>Cadastro de Monstro - Diário de Monstros</h1>

<div class="container mt-4">
    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Elemento.Nome">Nome</label>
                <input asp-for="Elemento.Nome" class="form-control" required />
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Elemento.Numero">Número</label>
                <input asp-for="Elemento.Numero" type="number" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Elemento.Vida">Vida</label>
                <input asp-for="Elemento.Vida" type="number" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Elemento.Peso">Peso</label>
                <input asp-for="Elemento.Peso" type="number" step="any" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Elemento.Velocidade">Velocidade</label>
                <input asp-for="Elemento.Velocidade" type="number" step="any" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Elemento.Forca">Força</label>
                <input asp-for="Elemento.Forca" type="number" step="any" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Elemento.Poder">Poder</label>
                <input asp-for="Elemento.Poder" type="number" step="any" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Elemento.Categoria">Categoria</label>
                <input asp-for="Elemento.Categoria" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Elemento.Descricao">Descrição</label>
            <textarea asp-for="Elemento.Descricao" class="form-control" rows="3"></textarea>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Elemento.Tipo">Tipo</label>
                <input asp-for="Elemento.Tipo" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Elemento.ElementoPoder">Elemento de Poder</label>
                <input asp-for="Elemento.ElementoPoder" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Elemento.Fraqueza">Fraqueza</label>
                <input asp-for="Elemento.Fraqueza" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Elemento.LocalDeNascimento">Local de Nascimento</label>
                <input asp-for="Elemento.LocalDeNascimento" class="form-control" />
            </div>
        </div>

        <hr />
        <h4>Imagem do Monstro</h4>

        <div class="mb-3">
            <label>Escolher imagem do computador</label>
            <input asp-for="ArquivoImagem" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
        </div>

        <button type="submit" class="btn btn-success">Cadastrar Monstro</button>
        <a asp-page="/Index" class="btn btn-secondary">Voltar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}