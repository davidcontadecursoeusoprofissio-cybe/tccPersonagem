
@page
@model tccDiarioDeMonstros.Pages.IndexModel

@{
    ViewData["Title"] = "Diário de Monstros - Home";
}

<div class="search-container mb-4">
    <form method="get" asp-page="/Pesquisa" class="d-flex gap-2">
        <input type="text" name="termo" class="form-control" placeholder="Pesquisar monstro..." required />
        <button type="submit" class="btn btn-primary">Pesquisar</button>
    </form>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Todos os Monstros</h2>
    <a asp-page="/Criar" class="btn btn-success">Cadastrar Novo Monstro</a>
</div>

<div class="product-grid">
    @foreach (var item in Model.Elementos)
    {
        <article class="produto-card border p-3 mb-3">
            @if (!string.IsNullOrEmpty(item.Imagem))
            {
                <img src="@item.Imagem" alt="Imagem do Monstro" class="produtos img-fluid" style="max-height:150px;" />
            }

            <h3>@item.Nome</h3>
            <p><strong>Número:</strong> @item.Numero</p>
            <p><strong>Vida:</strong> @item.Vida</p>
            <p><strong>Peso:</strong> @item.Peso</p>
            <p><strong>Velocidade:</strong> @item.Velocidade</p>
            <p><strong>Força:</strong> @item.Forca</p>
            <p><strong>Poder:</strong> @item.Poder</p>
            <p><strong>Categoria:</strong> @item.Categoria</p>
            <p><strong>Descrição:</strong> @item.Descricao</p>
            <p><strong>Tipo:</strong> @item.Tipo</p>
            <p><strong>Elemento:</strong> @item.ElementoPoder</p>
            <p><strong>Fraqueza:</strong> @item.Fraqueza</p>
            <p><strong>Local de Nascimento:</strong> @item.LocalDeNascimento</p>

            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.Id" />
                <button type="submit" class="btn btn-danger btn-sm">Deletar</button>
            </form>
        </article>
    }
</div>
